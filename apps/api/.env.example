# Neon Postgres connection string (get from the Neon dashboard)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Firebase service account JSON, base64-encoded (avoids Vercel newline-mangling
# on the PEM private key). Generate with:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# bcrypt cost factor, 8-14
BCRYPT_ROUNDS=12

# Exact origin of the deployed frontend (no trailing slash). Only this origin
# is allowed to make credentialed cross-origin requests.
FRONTEND_ORIGIN=http://localhost:3000

NODE_ENV=development
