rules_version = '2';

// Defense in depth only: the app never talks to Firestore from the client.
// All reads/writes go through apps/api's firebase-admin SDK, which bypasses
// these rules entirely. This blanket deny just guarantees that if a client
// SDK were ever mistakenly initialized in the browser, it could do nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
