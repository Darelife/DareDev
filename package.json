{
  "name": "daredev",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build": "npm run build:web && npm run build:api",
    "lint": "npm run lint --workspace=apps/web && npm run lint --workspace=apps/api",
    "seed-admin": "npm run seed-admin --workspace=apps/api",
    "seed-content": "tsx scripts/seed-content.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
